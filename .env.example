# Public production origin, without a trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only Neon Postgres connection string. Never expose it with NEXT_PUBLIC_.
DATABASE_URL=

# Cloudflare Turnstile. The site key is public; the secret is server-only.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Clerk protects only the spouses' administration area. The secret is server-only.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
# Production FAPI origin used by CSP, for example https://clerk.example.it
NEXT_PUBLIC_CLERK_FRONTEND_API_URL=
CLERK_TELEMETRY_DISABLED=1
NEXT_PUBLIC_CLERK_TELEMETRY_DISABLED=1

# Comma-separated email allowlist. A signed-in user not listed here is denied.
RSVP_ADMIN_EMAILS=
